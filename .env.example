# PostgreSQL bağlantısı
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ik_crm"

# TC Kimlik ve IBAN şifreleme anahtarı (32 byte hex)
# Üret: openssl rand -hex 32
ENCRYPTION_KEY=""

# Oturum (JWT) imza anahtarı
# Üret: openssl rand -base64 32
SESSION_SECRET=""

# Website entegrasyonu (server-to-server)
# Üret: openssl rand -hex 32
WEBSITE_INTEGRATION_SECRET=""

# test | production → source etiketi (website_test / website) belirler
WEBSITE_INTEGRATION_MODE="test"

# Güvenilir CORS origin'leri (virgülle ayrılmış)
WEBSITE_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,https://atalayik.com.tr,https://www.atalayik.com.tr"

# Tarayıcı push bildirimi (VAPID)
# Üret: node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:info@atalayik.com.tr"