// İK + saha işgücü CRM / ön muhasebe veri modeli
// Konvansiyon: çekirdek modeller Türkçe, enum sabitleri küçük harf.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum Rol {
  patron
  operasyon
  muhasebe
  saha_sorumlusu
  ik
  izleyici
}

// Hizmet verilen bölgeler
enum Bolge {
  kocaeli
  balikesir
}

enum IsciDurum {
  aktif
  pasif
  kara_liste
}

enum MusaitlikDurum {
  aktif
  yenilenecek
}

enum Vardiya {
  gunduz
  gece
}

enum Aciliyet {
  normal
  acil
}

enum TalepDurum {
  acik
  kismi
  dolu
  kapandi
}

enum AtamaDurum {
  atandi
  onaylandi
  tamamlandi
  iptal
}

enum PuantajDurum {
  geldi
  gec
  gelmedi
  yarim
}

enum AvansDurum {
  verildi
  mahsup
}

enum FaturaDurum {
  vadede
  odendi
  gecikti
}

enum GiderKategori {
  isci_yevmiye
  personel_bordro
  kira
  ulasim
  yakit
  sarf_malzeme
  diger
}

enum OdemeTip {
  kdv
  muhtasar_sgk
  maas
  gecici_vergi
}

enum ResmiOdemeDurum {
  beklemede
  odendi
  gecikti
}

enum PersonelDurum {
  aktif
  pasif
}

enum BildirimTur {
  belge
  sgk
  fatura
  vergi
  talep
  website
}

enum TekrarTip {
  gunluk
  haftalik
}

enum AdayDurum {
  basvurdu
  gorusuldu
  onaylandi
  reddedildi
}

enum OdemeKaynak {
  isci
  personel
}

enum OdemeDurum {
  odendi
  bekliyor
}

enum EvrakTip {
  firma_sozlesme
  isci_is_sozlesme
  kvkk_acik_riza
  diger
}

enum ServisciDurum {
  aktif
  pasif
}

// İK & Puantaj/Ödeme modülü
enum CalismaTipi {
  GUNLUK
  SAATLIK
}

enum OdemeYontemi {
  ELDEN
  IBAN
}

enum OdemeDonemiDurum {
  BEKLIYOR
  KISMI_ODENDI
  ODENDI
}

enum KesintiTuru {
  sgk
  avans_mahsup
  ceza
  diger
}

// Vergi & Resmi Ödemeler modülü
enum VergiTuru {
  KDV
  MUHTASAR
  STOPAJ
  GECICI_VERGI
  KURUMLAR
  SGK
  BAGKUR
  DAMGA
  DIGER
}

enum VergiOdemeYontemi {
  BANKA
  KREDI_KARTI
  NAKIT
}

// Esnek ödeme periyodu (maaş sabit aylık varsayılmaz)
enum OdemePeriyot {
  GUN_ARALIGI // kaç günde bir (gunAraligi alanı)
  HAFTALIK
  AYLIK
  SERBEST // elle yönetilir
}

// ============================================================
// ÇOKTAN-ÇOĞA BAĞLANTILAR
// ============================================================

model IsciMeslek {
  isciId   Int
  meslekId Int
  isci     Isci   @relation(fields: [isciId], references: [id], onDelete: Cascade)
  meslek   Meslek @relation(fields: [meslekId], references: [id], onDelete: Cascade)

  @@unique([isciId, meslekId])
}

// ============================================================
// MESLEK / İŞÇİ / BELGE / MÜSAİTLİK / AVANS
// ============================================================

model Meslek {
  id             Int           @id @default(autoincrement())
  ad             String        @unique
  isciler        IsciMeslek[]
  talepKalemleri TalepKalemi[]
  firmaFiyatlar  FirmaFiyat[]
  atamalar       Atama[]
  adaylar        Aday[]
}

model Isci {
  id                    Int       @id @default(autoincrement())
  ad                    String
  telefon               String
  tcKimlik              String // AES-256-GCM şifreli
  ilce                  String
  iban                  String // AES-256-GCM şifreli
  dogumTarihi           DateTime
  puan                  Int       @default(50)
  gunlukUcretBeklentisi Decimal   @db.Decimal(10, 2)
  durum                 IsciDurum @default(aktif)
  tercihBolgeler        String[]
  not                   String?
  bolge                 Bolge     @default(kocaeli)
  firmaId               Int? // İK modülü: personelin halihazırda çalıştığı firma
  calismaTipi           CalismaTipi       @default(GUNLUK)
  varsayilanOdemeYontemi OdemeYontemi      @default(ELDEN)
  odemePeriyot          OdemePeriyot? // null = firma varsayılanı
  gunAraligi            Int? // GUN_ARALIGI periyodunda kaç günde bir
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  meslekler    IsciMeslek[]
  belgeler     Belge[]
  musaitlikler Musaitlik[]
  avanslar     Avans[]
  hakedisler   Hakedis[]
  atamalar     Atama[]
  odemeler     Odeme[]
  evraklar     Evrak[]
  aramalar     Arama[]
  firma        MusteriFirma?      @relation(fields: [firmaId], references: [id], onDelete: SetNull)
  personelUcretler  PersonelUcret[]
  puantajKayitlari  PuantajKayit[]
  kesintiler        Kesinti[]
  odemeDonemleri    OdemeDonemi[]
}

model Belge {
  id            Int      @id @default(autoincrement())
  isciId        Int?
  personelId    Int?
  tip           String // ör: "Kimlik", "SGK", "Adli Sicil", "Vardiya Belgesi", "İSG Belgesi"
  verilisTarihi DateTime
  bitisTarihi   DateTime

  isci     Isci?     @relation(fields: [isciId], references: [id], onDelete: Cascade)
  personel Personel? @relation(fields: [personelId], references: [id], onDelete: Cascade)

  @@index([isciId, bitisTarihi])
  @@index([personelId, bitisTarihi])
}

model Musaitlik {
  id                Int            @id @default(autoincrement())
  isciId            Int
  tarih             DateTime // sözleşme/eVadesi geçerlilik tarihi
  eVadesiGun        Int            @default(30)
  sozlesmeBaslangic DateTime?
  sozlesmeBitis     DateTime?
  durum             MusaitlikDurum @default(aktif)

  isci Isci @relation(fields: [isciId], references: [id], onDelete: Cascade)

  @@index([isciId])
}

model Avans {
  id     Int        @id @default(autoincrement())
  isciId Int
  tutar  Decimal    @db.Decimal(10, 2)
  tarih  DateTime   @default(now())
  durum  AvansDurum @default(verildi)

  isci Isci @relation(fields: [isciId], references: [id], onDelete: Cascade)

  @@index([isciId, durum])
}

// ============================================================
// TELEFON ARAMALARI
// ============================================================

model Arama {
  id         Int      @id @default(autoincrement())
  isciId     Int
  kullaniciId Int?
  tarih      DateTime @default(now())

  isci     Isci?     @relation(fields: [isciId], references: [id], onDelete: Cascade)
  kullanici Kullanici? @relation(fields: [kullaniciId], references: [id], onDelete: SetNull)

  @@index([isciId, tarih])
}

// ============================================================
// MÜŞTERİ FİRMALAR
// ============================================================

model MusteriFirma {
  id        Int      @id @default(autoincrement())
  ad        String
  vergiNo   String?
  telefon   String?
  email     String?
  adres     String?
  bolge     Bolge    @default(kocaeli)
  odemePeriyot OdemePeriyot @default(AYLIK)
  gunAraligi Int      @default(30)
  createdAt DateTime @default(now())

  yetkililer  Yetkili[]
  lokasyonlar Lokasyon[]
  fiyatlar    FirmaFiyat[]
  talepler    Talep[]
  faturalar   Fatura[]
  hakedisler  Hakedis[]
  evraklar    Evrak[]
  isciler     Isci[]
  ucretAyarlari  FirmaUcret[]
  puantajKayitlari PuantajKayit[]
  odemeDonemleri  OdemeDonemi[]
  vergiOdemeleri  VergiOdemesi[]
  vergiSablonlari  VergiSablon[]
}

model Yetkili {
  id      Int     @id @default(autoincrement())
  firmaId Int
  ad      String
  unvan   String?
  telefon String?

  firma MusteriFirma @relation(fields: [firmaId], references: [id], onDelete: Cascade)
}

model Lokasyon {
  id      Int     @id @default(autoincrement())
  firmaId Int
  ad      String
  adres   String?

  firma        MusteriFirma @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  talepler     Talep[]
  kullanicilar Kullanici[]
}

model FirmaFiyat {
  id           Int     @id @default(autoincrement())
  firmaId      Int
  meslekId     Int
  kisiGunFiyat Decimal @db.Decimal(10, 2)

  firma  MusteriFirma @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  meslek Meslek       @relation(fields: [meslekId], references: [id], onDelete: Cascade)

  @@unique([firmaId, meslekId])
}

// ============================================================
// TALEP / ATAMA / PUANTAJ
// ============================================================

model Talep {
  id         Int        @id @default(autoincrement())
  firmaId    Int
  lokasyonId Int
  tarih      DateTime
  vardiya    Vardiya    @default(gunduz)
  aciliyet   Aciliyet   @default(normal)
  durum      TalepDurum @default(acik)
  not        String?
  sablon     Boolean    @default(false) // şablon talep
  tekrar     TekrarTip? // günlük/haftalık tekrar
  createdAt  DateTime   @default(now())

  // Website entegrasyonu
  kaynak       String? // website | website_test | ...
  landingPage  String?
  referrer     String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmContent   String?
  utmTerm      String?
  webRequestId String? @unique // idempotency (X-Idempotency-Key)

  firma    MusteriFirma  @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  lokasyon Lokasyon      @relation(fields: [lokasyonId], references: [id], onDelete: Cascade)
  kalemler TalepKalemi[]
  atamalar Atama[]

  @@index([tarih])
}

model TalepKalemi {
  id       Int @id @default(autoincrement())
  talepId  Int
  meslekId Int
  adet     Int

  talep  Talep  @relation(fields: [talepId], references: [id], onDelete: Cascade)
  meslek Meslek @relation(fields: [meslekId], references: [id], onDelete: Cascade)
}

model Atama {
  id            Int        @id @default(autoincrement())
  talepId       Int
  isciId        Int
  meslekId      Int? // atama hangi kalem/meslek için yapıldı (hakediş fiyatı için)
  tarih         DateTime
  durum         AtamaDurum @default(atandi)
  sgkBildirildi Boolean    @default(false)
  createdAt     DateTime   @default(now())

  talep   Talep    @relation(fields: [talepId], references: [id], onDelete: Cascade)
  isci    Isci     @relation(fields: [isciId], references: [id], onDelete: Cascade)
  meslek  Meslek?  @relation(fields: [meslekId], references: [id], onDelete: SetNull)
  puantaj Puantaj?

  // İş kuralı 1: aynı işçi aynı güne yalnızca bir atama
  @@unique([isciId, tarih])
  @@index([tarih, durum])
}

model Puantaj {
  id            Int          @id @default(autoincrement())
  atamaId       Int          @unique
  girisSaat     DateTime?
  cikisSaat     DateTime?
  calisilanSaat Decimal      @default(0) @db.Decimal(5, 2)
  mesaiSaat     Decimal      @default(0) @db.Decimal(5, 2)
  durum         PuantajDurum @default(geldi)

  atama Atama @relation(fields: [atamaId], references: [id], onDelete: Cascade)
}

// ============================================================
// HAKEDİŞ / FATURA / GELİR-GİDER
// ============================================================

model Hakedis {
  id           Int      @id @default(autoincrement())
  isciId       Int
  firmaId      Int
  atamaId      Int? // referans (tekrarsızlık donemKey üzerinden)
  donemKey     String // "2026-9" — işçi+firma+ay tekil anahtarı
  donemBas     DateTime
  donemBitis   DateTime
  gun          Int
  yevmiye      Decimal  @db.Decimal(10, 2) // işçinin günlüğü
  avansToplam  Decimal  @default(0) @db.Decimal(10, 2)
  kesinti      Decimal  @default(0) @db.Decimal(10, 2)
  isciNet      Decimal  @db.Decimal(10, 2) // gun*yevmiye - avans - kesinti
  musteriTutar Decimal  @db.Decimal(10, 2) // gun * FirmaFiyat (meslek bazlı)
  marj         Decimal  @db.Decimal(10, 2) // musteriTutar - gun*yevmiye
  createdAt    DateTime @default(now())

  isci  Isci         @relation(fields: [isciId], references: [id], onDelete: Cascade)
  firma MusteriFirma @relation(fields: [firmaId], references: [id], onDelete: Cascade)

  @@unique([isciId, firmaId, donemKey])
  @@index([isciId])
  @@index([firmaId])
}

model Fatura {
  id          Int         @id @default(autoincrement())
  firmaId     Int
  no          String      @unique
  donem       String // "2026-08"
  araToplam   Decimal     @db.Decimal(10, 2)
  kdvOran     Decimal     @default(0.20) @db.Decimal(4, 2)
  kdvTutar    Decimal     @db.Decimal(10, 2)
  genelToplam Decimal     @db.Decimal(10, 2)
  vadeTarihi  DateTime
  durum       FaturaDurum @default(vadede)
  createdAt   DateTime    @default(now())

  firma       MusteriFirma @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  tahsilatlar Tahsilat[]
}

model Tahsilat {
  id       Int      @id @default(autoincrement())
  faturaId Int
  tarih    DateTime @default(now())
  tutar    Decimal  @db.Decimal(10, 2)

  fatura Fatura @relation(fields: [faturaId], references: [id], onDelete: Cascade)
}

model Gider {
  id       Int           @id @default(autoincrement())
  kategori GiderKategori @default(diger)
  aciklama String?
  tutar    Decimal       @db.Decimal(10, 2)
  tarih    DateTime      @default(now())

  @@index([kategori, tarih])
}

model ResmiOdeme {
  id             Int             @id @default(autoincrement())
  tip            OdemeTip
  tutar          Decimal         @db.Decimal(10, 2)
  sonOdemeTarihi DateTime
  odemeTarihi    DateTime?
  durum          ResmiOdemeDurum @default(beklemede)
  createdAt      DateTime        @default(now())

  @@index([tip, sonOdemeTarihi])
}

// ============================================================
// PERSONEL (iç kadro)
// ============================================================

model Personel {
  id           Int           @id @default(autoincrement())
  ad           String
  departman    String
  rol          String
  iseGiris     DateTime
  maas         Decimal       @db.Decimal(10, 2)
  iban         String // AES-256-GCM şifreli
  sgkDurum     String
  izinBakiyesi Int           @default(0)
  durum        PersonelDurum @default(aktif)
  bolge        Bolge         @default(kocaeli)
  createdAt    DateTime      @default(now())

  izinler  Izin[]
  gecmis   PersonelGecmisi[]
  odemeler Odeme[]
  belgeler Belge[]
}

model Izin {
  id         Int      @id @default(autoincrement())
  personelId Int
  tarih      DateTime
  gun        Int
  tip        String // izin | rapor
  not        String?
  createdAt  DateTime @default(now())

  personel Personel @relation(fields: [personelId], references: [id], onDelete: Cascade)

  @@index([personelId])
}

model PersonelGecmisi {
  id         Int      @id @default(autoincrement())
  personelId Int
  tarih      DateTime @default(now())
  alan       String // departman | rol | maas
  eskiDeger  String
  yeniDeger  String

  personel Personel @relation(fields: [personelId], references: [id], onDelete: Cascade)

  @@index([personelId])
}

// ============================================================
// KULLANICI (giriş + RBAC) / BİLDİRİM
// ============================================================

model Kullanici {
  id         Int      @id @default(autoincrement())
  ad         String
  email      String   @unique
  sifreHash  String
  rol        Rol      @default(operasyon)
  lokasyonId Int? // yalnızca saha_sorumlusu için
  createdAt  DateTime @default(now())

  lokasyon    Lokasyon?  @relation(fields: [lokasyonId], references: [id], onDelete: SetNull)
  bildirimler Bildirim[]
  pushAbonelikler PushAbonelik[]
  aramalar    Arama[]
  etkinlikler KullaniciEtkinlik[]
  etkinlikKayitlari EtkinlikKayit[]
}

model Bildirim {
  id            Int         @id @default(autoincrement())
  kullaniciId   Int?
  tur           BildirimTur
  mesaj         String
  ilgiliId      Int?
  kanal         String? // sms | whatsapp (işçi bilgilendirme iskeleti)
  hedef         String? // telefon
  gonderimDurum Boolean     @default(false)
  tarih         DateTime    @default(now())
  okundu        Boolean     @default(false)
  kaldirildi    Boolean     @default(false) // header feed'den kaldırıldı (geçmiş korunur)

  kullanici Kullanici? @relation(fields: [kullaniciId], references: [id], onDelete: Cascade)

  @@index([kullaniciId, okundu])
}

// ============================================================
// SERVİSÇİLER (servis şoförleri — kavli, KDV'siz ödeme)
// ============================================================

model Servisci {
  id        Int           @id @default(autoincrement())
  ad        String
  telefon   String
  bolge     Bolge         @default(kocaeli)
  durum     ServisciDurum @default(aktif)
  not       String?
  createdAt DateTime      @default(now())

  servisler Servis[]

  @@index([bolge])
}

model Servis {
  id         Int      @id @default(autoincrement())
  servisciId Int
  tarih      DateTime
  guzergah   String? // ne yaptı / nereye servis
  tutar      Decimal  @db.Decimal(10, 2) // kavli tutar — KDV'siz
  not        String?
  createdAt  DateTime @default(now())

  servisci Servisci @relation(fields: [servisciId], references: [id], onDelete: Cascade)

  @@index([servisciId])
}

// ============================================================
// İK & PUANTAJ / ÖDEME MODÜLÜ
// (personel = saha işçisi; ücret: personel > firma > sistem varsayılanı)
// ============================================================

model PersonelUcret {
  id                   Int       @id @default(autoincrement())
  isciId               Int
  gunlukUcret          Decimal   @db.Decimal(12, 2)
  saatlikUcret         Decimal   @db.Decimal(12, 2)
  gecerlilikBaslangic  DateTime
  gecerlilikBitis      DateTime?
  olusturanKullaniciId Int?
  createdAt            DateTime  @default(now())

  isci Isci @relation(fields: [isciId], references: [id], onDelete: Cascade)

  @@index([isciId])
}

model FirmaUcret {
  id                  Int      @id @default(autoincrement())
  firmaId             Int
  gunlukUcret         Decimal  @db.Decimal(12, 2)
  saatlikUcret        Decimal  @db.Decimal(12, 2)
  gecerlilikBaslangic DateTime
  gecerlilikBitis     DateTime?
  createdAt           DateTime @default(now())

  firma MusteriFirma @relation(fields: [firmaId], references: [id], onDelete: Cascade)

  @@unique([firmaId, gecerlilikBaslangic])
  @@index([firmaId])
}

model PuantajKayit {
  id                    Int          @id @default(autoincrement())
  isciId                Int
  firmaId               Int
  tarih                 DateTime
  fsi                   Decimal      @default(1) @db.Decimal(3, 2) // 1 tam gün | 0.5 yarım gün
  calismaTipi           CalismaTipi  @default(GUNLUK)
  calisilanSaat         Decimal      @default(0) @db.Decimal(5, 2)
  mesaiSaat             Decimal      @default(0) @db.Decimal(5, 2)
  uygulananGunlukUcret  Decimal      @db.Decimal(12, 2)
  uygulananSaatlikUcret Decimal      @db.Decimal(12, 2)
  hesaplananTutar       Decimal      @db.Decimal(12, 2)
  ucretManuelMi         Boolean      @default(false) // ücret elle ezildi mi
  aciklama              String?
  createdAt             DateTime     @default(now())

  isci  Isci         @relation(fields: [isciId], references: [id], onDelete: Cascade)
  firma MusteriFirma @relation(fields: [firmaId], references: [id], onDelete: Cascade)

  @@unique([isciId, tarih])
  @@index([isciId, tarih])
}

model Kesinti {
  id       Int         @id @default(autoincrement())
  isciId   Int
  tarih    DateTime    @default(now())
  tutar    Decimal     @db.Decimal(12, 2)
  tur      KesintiTuru @default(diger)
  aciklama String?

  isci Isci @relation(fields: [isciId], references: [id], onDelete: Cascade)

  @@index([isciId])
}

model OdemeDonemi {
  id            Int               @id @default(autoincrement())
  isciId        Int
  firmaId       Int
  baslangic     DateTime
  bitis         DateTime
  brutHakedis   Decimal           @db.Decimal(12, 2)
  toplamAvans   Decimal           @default(0) @db.Decimal(12, 2)
  toplamKesinti Decimal           @default(0) @db.Decimal(12, 2)
  netOdenecek   Decimal           @db.Decimal(12, 2)
  durum         OdemeDonemiDurum  @default(BEKLIYOR)
  kilitli       Boolean           @default(false) // ödenen dönem kilitli
  createdAt     DateTime          @default(now())

  isci    Isci         @relation(fields: [isciId], references: [id], onDelete: Cascade)
  firma   MusteriFirma @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  odemeler OdemeKayit[]

  @@unique([isciId, firmaId, baslangic, bitis])
  @@index([isciId])
}

model OdemeKayit {
  id                    Int           @id @default(autoincrement())
  donemId               Int
  tarih                 DateTime      @default(now())
  tutar                 Decimal       @db.Decimal(12, 2)
  yontem                OdemeYontemi
  ibanSnapshot          String?
  hesapSahibi           String?
  yakininaOdeme         Boolean       @default(false)
  yakinlikNotu          String?
  zarfNo                String?
  teslimAlan            String?
  teslimEdenKullaniciId Int?
  dekontUrl             String?
  not                    String?
  createdAt             DateTime      @default(now())

  donem OdemeDonemi @relation(fields: [donemId], references: [id], onDelete: Cascade)

  @@index([donemId])
}

model UcretLog {
  id          Int      @id @default(autoincrement())
  kayitTipi   String // personel | firma | sistem
  ilgiliId    Int?
  alan        String // gunlukUcret | saatlikUcret | varsayilanUcret | mesaiCarpan | calismaTipi | odemeYontemi
  eskiDeger   String?
  yeniDeger   String?
  kullaniciId Int?
  tarih       DateTime @default(now())

  @@index([kayitTipi, ilgiliId])
}

// ============================================================
// VERGİ & RESMİ ÖDEMELER MODÜLÜ
// (firma bazlı vergi kaydı + dekont arşivi + tekrarlayan şablon)
// ============================================================

model VergiOdemesi {
  id                  Int                 @id @default(autoincrement())
  firmaId             Int
  vergiTuru           VergiTuru
  vergiTuruDiger      String? // DIGER seçilirse serbest metin
  donem               String // "2026-09" veya "2026 Q3"
  tahakkukTutari      Decimal             @db.Decimal(12, 2)
  sonOdemeTarihi      DateTime
  odemeTarihi         DateTime?
  odenenTutar         Decimal?            @db.Decimal(12, 2)
  odemeYontemi        VergiOdemeYontemi?
  not                  String?
  olusturanKullaniciId Int?
  createdAt           DateTime            @default(now())
  silindi             Boolean             @default(false) // soft delete

  firma      MusteriFirma @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  dekontlar  VergiDekont[]

  @@index([firmaId])
  @@index([sonOdemeTarihi])
  @@index([vergiTuru])
}

model VergiDekont {
  id                  Int       @id @default(autoincrement())
  vergiOdemeId        Int
  dosyaUrl            String
  dosyaAdi            String
  dosyaTipi           String // pdf | jpg | png | ...
  dosyaBoyutu         Int?
  yukleyenKullaniciId Int?
  createdAt           DateTime  @default(now())
  silindi             Boolean   @default(false) // soft delete

  vergiOdeme VergiOdemesi @relation(fields: [vergiOdemeId], references: [id], onDelete: Cascade)

  @@index([vergiOdemeId])
}

model VergiSablon {
  id              Int       @id @default(autoincrement())
  firmaId         Int
  vergiTuru       VergiTuru
  vergiTuruDiger  String?
  tahakkukTutari  Decimal   @db.Decimal(12, 2)
  sonOdemeGun     Int // ayın kaçında (1-28)
  donemEtiketi    String? // ör: "Q3" — boşsa aylık
  aktif           Boolean   @default(true)
  createdAt       DateTime  @default(now())

  firma MusteriFirma @relation(fields: [firmaId], references: [id], onDelete: Cascade)

  @@index([firmaId])
}

// ============================================================
// İŞE ALIM / BORDRO-ÖDEME / EVRAK / AYARLAR
// ============================================================

model Aday {
  id        Int       @id @default(autoincrement())
  ad        String
  telefon   String
  email     String?
  meslekId  Int?
  durum     AdayDurum @default(basvurdu)
  puan      Int       @default(50)
  not       String?
  bolge     Bolge? // website'ten gelen aday atanmamış olabilir — panelden atanır
  createdAt DateTime  @default(now())

  // Website entegrasyonu
  kaynak       String? // website | website_test | ...
  cvYolu       String? // public/uploads/cv/...
  cvDosyaAdi   String?
  ilanId       Int? // başvurduğu iş ilanı
  webRequestId String? @unique // idempotency

  meslek Meslek? @relation(fields: [meslekId], references: [id], onDelete: SetNull)
  ilan   Job?    @relation(fields: [ilanId], references: [id], onDelete: SetNull)

  @@index([telefon])
  @@index([email])
}

// Website'te yayınlanan açık pozisyonlar / iş ilanları
model Job {
  id               Int      @id @default(autoincrement())
  slug             String   @unique
  baslik           String
  lokasyon         String?
  calismaTipi      String? // tam_zamanli | yari_zamanli | ...
  aciklama         String?
  gereksinimler    String[]
  yayinlandi       Boolean  @default(false) // website'te yayınlandı mı
  yayinTarihi      DateTime?
  gecerlilikTarihi DateTime? // validThrough
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  adaylar Aday[]
}

model Odeme {
  id          Int         @id @default(autoincrement())
  tip         OdemeKaynak
  isciId      Int?
  personelId  Int?
  tutar       Decimal     @db.Decimal(10, 2)
  donem       String // "2026-08"
  durum       OdemeDurum  @default(bekliyor)
  odemeTarihi DateTime?
  createdAt   DateTime    @default(now())

  isci     Isci?     @relation(fields: [isciId], references: [id], onDelete: SetNull)
  personel Personel? @relation(fields: [personelId], references: [id], onDelete: SetNull)

  @@index([durum])
}

model Evrak {
  id            Int      @id @default(autoincrement())
  tip           EvrakTip
  baslik        String
  dosyaAdi      String
  dosyaYol      String // Blob URL (production) veya /uploads/... (yerel dev)
  mime          String? // içerik türü (metadata)
  boyut         Int? // byte cinsinden boyut (metadata)
  ilgiliFirmaId Int?
  ilgiliIsciId  Int?
  yuklemeTarihi DateTime @default(now())

  firma MusteriFirma? @relation(fields: [ilgiliFirmaId], references: [id], onDelete: Cascade)
  isci  Isci?         @relation(fields: [ilgiliIsciId], references: [id], onDelete: Cascade)
}

model Ayar {
  id       Int     @id @default(autoincrement())
  anahtar  String  @unique
  deger    String
  aciklama String?
}

// Tarayıcı push bildirimi abonelikleri
model PushAbonelik {
  id          Int      @id @default(autoincrement())
  kullaniciId Int
  endpoint    String   @unique
  p256dh      String
  auth        String
  createdAt   DateTime @default(now())

  kullanici Kullanici @relation(fields: [kullaniciId], references: [id], onDelete: Cascade)

  @@index([kullaniciId])
}

// ============================================================
// KULLANICI ETKİNLİK LOGU (yalnızca admin görür)
// ============================================================

model KullaniciEtkinlik {
  id           Int      @id @default(autoincrement())
  kullaniciId  Int
  tarih        DateTime // gün (startOfDay)
  girisSayisi  Int      @default(0)
  aktifDakika  Int      @default(0)
  sonAktivite  DateTime?

  kullanici Kullanici @relation(fields: [kullaniciId], references: [id], onDelete: Cascade)

  @@unique([kullaniciId, tarih])
  @@index([tarih])
}

model EtkinlikKayit {
  id          Int      @id @default(autoincrement())
  kullaniciId Int
  tarih       DateTime @default(now())
  islem       String // "Giriş yaptı", "Çıkış yaptı", "Sayfa: /puantaj"

  kullanici Kullanici @relation(fields: [kullaniciId], references: [id], onDelete: Cascade)

  @@index([kullaniciId, tarih])
  @@index([tarih])
}
